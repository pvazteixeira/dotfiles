function stm() {
    # create/attach tmux session 0 locally (remotely via ssh -X if host provided)
    if (( $# == 1 ))
    then
        ssh $1 -X -t tmux new-session -A -s 0
    else
        tmux new-session -A -s 0
    fi
}

function szm() {
    if (( $# == 1 )); then
        ssh "$1" -X -t zellij attach -c 0
    else
        zellij attach -c 0
    fi
}

function dot2png() {
    sfdp -Tpng $1 -o $2
}

