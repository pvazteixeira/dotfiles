# chezmoi's config template: at `chezmoi init` this is rendered to
# ~/.config/chezmoi/chezmoi.toml. It must be named *.tmpl for chezmoi to treat
# it as the config template (the only templated bit is the home dir below).
#
# Its job: persist sourceDir so later `chezmoi apply`/`chezmoi update` find the
# source without re-passing --source (init still needs --source the first time).
sourceDir = "{{ .chezmoi.homeDir }}/workspace/personal/dotfiles/home"
